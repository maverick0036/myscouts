# Copy to .env and fill in. Never commit or share .env.
ANTHROPIC_API_KEY=sk-ant-...
# Any long random string; you type it into the app once. Generate one with: openssl rand -hex 16
APP_TOKEN=
# Optional: model override (default claude-opus-5-5). claude-sonnet-5-5 is about half the cost.
# TOPIC_SCOUT_MODEL=claude-opus-5-5
# Optional: Reddit API app credentials, once Reddit approves your registration.
# With these, Reddit works from the cloud too and runs in seconds instead of ~1 request/min.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
